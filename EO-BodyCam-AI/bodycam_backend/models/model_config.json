        "faltu kaam", "فالتو کام",
        "bore ho gaya", "بور ہو گیا",
        "mujhe nahi pata", "مجھے نہیں پتا",
        "tum log aise hi ho", "تم لوگ ایسے ہی ہو",
        "ye area hi aisa hai", "یہ ایریا ہی ایسا ہے",
        "sab chor hain yahan", "سب چور ہیں یہاں",
        "tumhara koi bharosa nahi", "تمہارا کوئی بھروسا نہیں"
      ]
    }
  }
}
