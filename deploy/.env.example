# ─────────────────────────────────────────────────────────────────
# Copy this file to .env on the VM and fill in real values.
# .env is .gitignored — never commit it.
# ─────────────────────────────────────────────────────────────────

# ─── REQUIRED ────────────────────────────────────────────────
# Your Gemini API key. Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy-PUT-YOUR-KEY-HERE

# Strong password for the MSSQL `sa` user. 8+ chars, mix of upper/lower/digit/symbol.
MSSQL_SA_PASSWORD=ChangeMeStrong#2026

# ─── OPTIONAL ─────────────────────────────────────────────────
# Public IP of the VM — used by .NET CORS to allow http://<ip>/.
# Leave blank if you only access via the Cloudflare tunnel URL.
VM_PUBLIC_IP=

# Default officer/station tags assigned to videos that don't carry
# their own ID in the filename (e.g. videos dropped into Inbox/).
DEFAULT_OFFICER_ID=EO000
DEFAULT_STATION_ID=auto:watch-folder
