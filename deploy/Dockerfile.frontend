# ─────────────────────────────────────────────────────────────────
# Frontend — multi-stage. Build with Node, serve via nginx.
# Build-time env vars get baked into the JS bundle.
# ─────────────────────────────────────────────────────────────────
FROM node:20-alpine AS build

WORKDIR /app

# Copy package files first so npm install caches.
COPY EO-BodyCam-AI/bodycam_frontend/package*.json ./
RUN npm ci || npm install

# Copy source + build.
COPY EO-BodyCam-AI/bodycam_frontend/ ./

# These get inlined into the static JS bundle at build time. The
# default values match nginx's reverse-proxy paths so calls go
# back through the same origin (no CORS, simple URL).
ARG VITE_API_URL=/py-api
ARG VITE_DOTNET_API_URL=/api
ENV VITE_API_URL=$VITE_API_URL \
    VITE_DOTNET_API_URL=$VITE_DOTNET_API_URL

RUN npm run build

# ─── Runtime image — nginx serves the built static files ────────
FROM nginx:1.27-alpine AS runtime

# Drop the default site config — we mount our own via compose.
RUN rm -f /etc/nginx/conf.d/default.conf

COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
