# NEVER commit appsettings.json — contains Gemini API key + DB connection string.
# Google's bots scan GitHub for AIza* keys and revoke them within minutes.
# Each developer keeps their own local copy. A template lives at
# appsettings.json.example with placeholder values.
PERA360.Api/appsettings.json
appsettings.json
appsettings.*.local.json
appsettings.Local.json
appsettings.local.json
appsettings.Development.local.json

# Secret/credential files (any future variant)
.env
*.env
.env.*
secrets.json
*.secret
*.secret.json
credentials.json
*.credentials.json

# Local watch folder data (don't commit user uploads / processing results)
WatchFolder/Inbox/*
WatchFolder/Processed/
WatchFolder/Failed/
!WatchFolder/Inbox/.gitkeep
