{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "// MSSQL options — pick the one that matches your install": "",
    "// LocalDB (lightweight, comes with VS)": "Server=(localdb)\\MSSQLLocalDB;Database=bodycam_ai;Trusted_Connection=True;TrustServerCertificate=True;",
    "// Express (default instance, Windows auth)": "Server=.\\SQLEXPRESS;Database=bodycam_ai;Trusted_Connection=True;TrustServerCertificate=True;",
    "// Standard / Developer / Express (named user)": "Server=localhost;Database=bodycam_ai;User Id=bodycam;Password=BodyCam@2026;TrustServerCertificate=True;",
    "MsSql": "Server=localhost\\SQLEXPRESS;Database=bodycam_ai;Trusted_Connection=True;TrustServerCertificate=True;"
  },

  "Ffmpeg": {
    "// Path": "Absolute path to ffmpeg.exe. Read first — if empty, falls back to FFMPEG_PATH env var, then to plain 'ffmpeg' (PATH lookup).",
    "Path": "C:\\Users\\irfan\\AppData\\Local\\Microsoft\\WinGet\\Packages\\Gyan.FFmpeg.Essentials_Microsoft.Winget.Source_8wekyb3d8bbwe\\ffmpeg-8.1-essentials_build\\bin\\ffmpeg.exe"
  },

  "Python": {
    "// BaseUrl points at the Python (Flask) ML pipeline that does the heavy lifting.": "",
    "// The .NET backend extracts audio with ffmpeg, then forwards the audio here.": "",
    "BaseUrl": "http://localhost:5050",
    "TimeoutSeconds": 600
  },

  "Gemini": {
    "// Get a key at https://aistudio.google.com/app/apikey and paste it below.": "",
    "ApiKey": "",
    "// Model": "gemini-2.5-flash-lite is the latest free-tier multimodal model on AI Studio (April 2026). Pro models are paid since April 1, 2026.",
    "Model": "gemini-2.5-flash-lite",
    "BaseUrl": "https://generativelanguage.googleapis.com/v1beta",
    "TimeoutSeconds": 600
  },

  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:3000",
      "http://localhost:4173"
    ]
  },

  "WatchFolder": {
    "// Drop a video into Path/Inbox and the backend auto-runs the same": "",
    "// analysis pipeline used by /api/analyse. Successful files move to": "",
    "// Path/Processed/<date>/, failures to Path/Failed/<date>/.": "",
    "// Relative path is resolved against the solution root, so the default": "",
    "// lands at <repo>\\WatchFolder\\ alongside BodyCamAI.Api etc.": "",
    "Enabled": true,
    "Path": "WatchFolder",
    "InboxSubfolder": "Inbox",
    "ProcessedSubfolder": "Processed",
    "FailedSubfolder": "Failed",
    "// Officer ID rule: filename '<officerId>__rest.mp4' wins; else default below.": "",
    "DefaultOfficerId": "EO000",
    "DefaultStationId": "auto:watch-folder",
    "PollSeconds": 5,
    "StableSeconds": 3,
    "MaxConcurrent": 2,
    "AllowedExtensions": [
      ".mp4", ".mov", ".webm", ".mkv", ".avi", ".3gp", ".flv", ".wmv", ".m4v",
      ".wav", ".mp3", ".m4a", ".ogg", ".flac"
    ]
  }
}
